{
  "TAC": {
    "name": "Technical Assistance Center",
    "equipment": [
      {
        "id": "dell",
        "name": "Dell (Windows - OS)",
        "fields": [
          {
            "name": "dell_asset_tag",
            "label": "Asset Tag",
            "type": "text",
            "required": true,
            "placeholder": "Enter asset tag number"
          },
          {
            "name": "dell_os_version",
            "label": "Windows Version",
            "type": "text",
            "required": true,
            "placeholder": "e.g., Windows 11 Pro"
          },
          {
            "name": "dell_accessories",
            "label": "Accessories Needed",
            "type": "checkbox",
            "options": ["Charger", "Mouse", "Docking Station", "Bag"]
          }
        ]
      },
      {
        "id": "macbook",
        "name": "Macbook (MacOS - OS)",
        "fields": [
          {
            "name": "macbook_asset_tag",
            "label": "Asset Tag",
            "type": "text",
            "required": true,
            "placeholder": "Enter asset tag number"
          },
          {
            "name": "macbook_os_version",
            "label": "macOS Version",
            "type": "text",
            "required": true,
            "placeholder": "e.g., Sonoma 14.0"
          },
          {
            "name": "macbook_screen_size",
            "label": "Screen Size",
            "type": "select",
            "options": ["13-inch", "14-inch", "16-inch"],
            "required": true
          }
        ]
      },
      {
        "id": "usbc_charger",
