            "type": "select",
            "options": ["30W", "45W", "60W", "96W", "140W"],
            "required": true
          },
          {
            "name": "charger_quantity",
            "label": "Quantity",
            "type": "number",
            "required": true,
            "placeholder": "Number of chargers needed"
          }
        ]
      }
    ]
  },
  "HD": {
