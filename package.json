{
  "name": "csc550-project",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "lint": "cd frontend && npm run build",
    "test": "cd frontend && npm test",
    "db:reset": "./database/run-migrations.sh && node ./database/seeds/seedAll.js",
    "start": "npm run dev",
    "install-all": "npm install && cd backend && npm install && cd ../frontend/my-app && npm install"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1"
  }
}
